// Database Schema for MomentOS
// File: backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organization - the top-level tenant
model Organization {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("UTC") // e.g. "Africa/Lagos", "America/Los_Angeles"
  birthdaySendHour   Int      @default(9)
  birthdaySendMinute Int      @default(0)
  birthdayLastRunAt  DateTime?
  plan      OrgPlan  @default(FREE)
  isSuspended Boolean @default(false)
  suspendedAt DateTime?
  
  // Email configuration
  emailFromName    String?
  emailFromAddress String?
  smsEnabled       Boolean   @default(false)
  whatsappEnabled  Boolean   @default(false)
  senderId         String?   @default("MomentOS")
  
  // Relationships
  users         User[]
  people        Person[]
  templateAssignments OrganizationTemplate[]
  deliveryLogs  DeliveryLog[]
  systemErrorLogs SystemErrorLog[]
  moments       Moment[]
  onboarding    OnboardingProgress?
  schedulerRuns SchedulerRun[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaigns     Campaign[]
  campaignTemplates CampaignTemplate[]
  
  @@map("organizations")
}

enum OrgPlan {
  FREE
  TRIAL
  PAID
}

// Admin users who manage the system
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(ADMIN)
  emailVerifiedAt DateTime?
  lastLoginAt    DateTime?
  isDisabled     Boolean      @default(false)
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  otps           Otp[]
  ownedMoments   Moment[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaigns      Campaign[]
  
  @@map("users")
}

enum UserRole {
  ADMIN
  VIEWER
}

// One-time passcodes for verification and reset flows
model Otp {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OtpPurpose
  codeHash  String
  attempts  Int      @default(0)
  maxAttempts Int    @default(5)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@map("otps")
}

enum OtpPurpose {
  REGISTER_VERIFY
  PASSWORD_RESET
}

// Per-organization onboarding progress
model OnboardingProgress {
  id        String   @id @default(cuid())
  organizationId String @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  completedSteps String[]
  testEmailSentAt DateTime?
  automationActivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("onboarding_progress")
}

// People whose birthdays we're tracking
model Person {
  id        String   @id @default(cuid())
  
  // Core fields
  fullName   String
  firstName  String? // Optional - extracted or provided
  email      String
  phone      String?
  birthday   DateTime // Stored as date only, time ignored
  
  // Optional fields
  department String?
  role       String?
  
  // System fields
  optedOut   Boolean  @default(false)
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  deliveryLogs DeliveryLog[]
  momentRecipients MomentRecipient[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Email must be unique per organization
  @@unique([organizationId, email])
  @@map("people")
}

// Email templates
model Template {
  id      String       @id @default(cuid())
  name    String
  type    TemplateType
  
  // Template content
  subject    String
  content    String      @db.Text
  imageUrl   String?     // For custom_image type
  
  // Flags
  isActive   Boolean     @default(true)
  isSystem   Boolean     @default(false)
  channels   DeliveryChannel[] @default([email])

  organizations OrganizationTemplate[]
  
  deliveryLogs DeliveryLog[]
  moments      Moment[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaigns     Campaign[]
  
  @@map("templates")
}

enum TemplateType {
  PLAIN_TEXT
  HTML
  CUSTOM_IMAGE
}

enum DeliveryChannel {
  email
  sms
  whatsapp
}

// Delivery tracking
model DeliveryLog {
  id        String        @id @default(cuid())
  
  // What was sent
  personId    String
  person      Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  templateId  String
  template    Template    @relation(fields: [templateId], references: [id])

  momentId    String?
  moment      Moment?     @relation(fields: [momentId], references: [id], onDelete: SetNull)
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Delivery details
  status        DeliveryStatus @default(QUEUED)
  channel       DeliveryChannel @default(email)
  scheduledFor  DateTime       // When it should be sent
  sentAt        DateTime?      // When it was actually sent
  deliveredAt   DateTime?      // When email was delivered
  
  // Error handling
  errorMessage  String?        @db.Text
  retryCount    Int            @default(0)
  
  // Tracking
  externalId    String?        // Email provider's tracking ID
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([momentId])
  
  @@map("delivery_logs")
}

model Moment {
  id                  String            @id @default(cuid())
  title               String
  category            MomentCategory
  eventDate           DateTime
  recurrenceRule      MomentRecurrence  @default(ANNUAL)
  customIntervalDays  Int?
  randomizeMessage    Boolean           @default(false)
  deliveryChannels    DeliveryChannel[] @default([email])
  templateId          String?
  template            Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  ownerType           MomentOwnerType   @default(ORGANIZATION)
  ownerOrganizationId String?
  ownerOrganization   Organization?     @relation(fields: [ownerOrganizationId], references: [id], onDelete: Cascade)
  ownerUserId         String?
  ownerUser           User?             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  status              MomentStatus      @default(ACTIVE)
  recipients          MomentRecipient[]
  deliveryLogs        DeliveryLog[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([ownerOrganizationId, status])
  @@index([ownerUserId, status])
  @@index([eventDate, recurrenceRule, status])
  @@map("moments")
}

model MomentRecipient {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([momentId, personId])
  @@index([personId])
  @@map("moment_recipients")
}

model OrganizationTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  assignedAt     DateTime     @default(now())

  @@unique([organizationId, templateId])
  @@map("organization_templates")
}

model SchedulerRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runDate        String
  runTime        DateTime     @default(now())

  @@unique([organizationId, runDate])
  @@map("scheduler_runs")
}

enum MomentCategory {
  BIRTHDAY
  ANNIVERSARY
  GRADUATION
  PROMOTION_CAREER_MILESTONE
  SPIRITUAL_MILESTONE
  REMEMBRANCE_DAY
  CUSTOM
}

enum MomentRecurrence {
  ONE_TIME
  ANNUAL
  DAILY
  MONTHLY
  QUARTERLY
  BI_YEARLY
  CUSTOM
}

enum MomentOwnerType {
  ORGANIZATION
  USER
}

enum MomentStatus {
  ACTIVE
  PAUSED
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  organization String
  role         String?
  teamSize     String?
  country      String?
  createdAt    DateTime @default(now())

  @@map("waitlist_entries")
}

model SystemErrorLog {
  id             String          @id @default(cuid())
  source         String
  category       String
  severity       ErrorSeverity   @default(ERROR)
  message        String          @db.Text
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  channel        DeliveryChannel?
  metadata       Json?
  createdAt      DateTime        @default(now())

  @@index([source, createdAt])
  @@index([category, createdAt])
  @@index([organizationId, createdAt])
  @@map("system_error_logs")
}

enum DeliveryStatus {
  QUEUED          // Ready to send
  SENDING         // Currently being sent
  SENT            // Successfully sent to provider
  DELIVERED       // Confirmed delivered by provider
  FAILED          // Failed after retries
  OPTED_OUT       // Person opted out
}

enum ErrorSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

// Internal admin users (MomentOS staff)
model AdminUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  role         AdminRole    @default(SUPER_ADMIN)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?

  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
  invitesSent  AdminInvite[] @relation("AdminInviteCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
}

model AdminSession {
  id         String   @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@map("admin_sessions")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("admin_audit_logs")
}

model AdminInvite {
  id         String     @id @default(cuid())
  email      String
  role       AdminRole  @default(SUPPORT)
  tokenHash  String     @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdBy  String
  creator    AdminUser  @relation("AdminInviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@map("admin_invites")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

/// A campaign sends to its own uploaded contact list, never to `people`.
/// Recurrence reuses MomentRecurrence so the worker shares one due-date engine.
model Campaign {
  id                 String             @id @default(cuid())
  name               String
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId    String?
  createdBy          User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  subject            String
  bodyText           String
  bodyHtml           String?
  smsText            String?
  replyTo            String?
  templateId         String?
  template           Template?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaignTemplateId String?
  campaignTemplate   CampaignTemplate?  @relation(fields: [campaignTemplateId], references: [id], onDelete: SetNull)
  deliveryChannels   DeliveryChannel[]  @default([email])
  recurrenceRule     MomentRecurrence   @default(ONE_TIME)
  customIntervalDays Int?
  startDate          DateTime
  endDate            DateTime?
  sendHour           Int                @default(9)
  sendMinute         Int                @default(0)
  status             CampaignStatus     @default(DRAFT)
  lastRunAt          DateTime?
  lastRunDate        String?
  runCount           Int                @default(0)
  contacts           CampaignContact[]
  deliveries         CampaignDelivery[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([status, startDate])
  @@map("campaigns")
}

model CampaignContact {
  id         String             @id @default(cuid())
  campaignId String
  campaign   Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String?
  email      String?
  phone      String?
  optedOut   Boolean            @default(false)
  attributes Json?
  deliveries CampaignDelivery[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([campaignId, email])
  @@index([campaignId])
  @@map("campaign_contacts")
}

model CampaignDelivery {
  id             String          @id @default(cuid())
  campaignId     String
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId      String
  contact        CampaignContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String
  channel        DeliveryChannel
  status         DeliveryStatus  @default(QUEUED)
  runDate        String
  scheduledFor   DateTime
  sentAt         DateTime?
  errorMessage   String?
  externalId     String?
  segments       Int?
  createdAt      DateTime        @default(now())

  @@unique([campaignId, contactId, channel, runDate])
  @@index([campaignId, createdAt])
  @@index([organizationId, createdAt])
  @@map("campaign_deliveries")
}

/// Templates owned by Campaigns. Deliberately separate from the shared Template
/// table, which Moments also render: a campaign template carries a {{body}}
/// slot that only the campaign sender knows how to fill, and putting that token
/// in a shared template would leak the literal "{{body}}" into moment emails.
model CampaignTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Optional default; a campaign's own subject wins when set.
  subject        String?
  /// HTML wrapper containing a {{body}} slot.
  content        String
  /// Seeded starters, visible to every organization and not editable by them.
  isSystem       Boolean      @default(false)
  isActive       Boolean      @default(true)
  campaigns      Campaign[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
  @@map("campaign_templates")
}
