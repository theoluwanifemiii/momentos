{
  "name": "momentos-worker",
  "version": "1.0.0",
  "description": "MomentOS Scheduler Worker",
  "main": "dist/scheduler.js",
  "scripts": {
    "dev": "tsx watch scheduler.ts",
    "start": "node dist/scheduler.js",
    "build": "PRISMA_CLI_BINARY_TARGETS=debian-openssl-1.1.x npx prisma generate --schema=prisma/schema.prisma && tsc",
    "postinstall": "PRISMA_CLI_BINARY_TARGETS=debian-openssl-1.1.x npx prisma generate --schema=prisma/schema.prisma",
    "verify:observability-env": "tsx scripts/verifyObservabilityEnv.ts",
    "smoke:observability": "tsx scripts/observabilitySmokeTest.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "dotenv": "^17.2.3",
    "luxon": "^3.7.2",
    "node-cron": "^3.0.3",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.10.8",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.8.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3"
  }
}
