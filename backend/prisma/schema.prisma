generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String                 @id @default(cuid())
  name                String
  timezone            String                 @default("UTC")
  emailFromName       String?
  emailFromAddress    String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  birthdayLastRunAt   DateTime?
  birthdaySendHour    Int                    @default(9)
  birthdaySendMinute  Int                    @default(0)
  isSuspended         Boolean                @default(false)
  plan                OrgPlan                @default(FREE)
  suspendedAt         DateTime?
  smsEnabled          Boolean                @default(false)
  senderId            String?                @default("MomentOS")
  whatsappEnabled     Boolean                @default(false)
  deliveryLogs        DeliveryLog[]
  onboarding          OnboardingProgress?
  templateAssignments OrganizationTemplate[]
  people              Person[]
  schedulerRuns       SchedulerRun[]
  users               User[]
  Moment              Moment[]
  systemErrorLogs     SystemErrorLog[]
  feedbackEntries     FeedbackEntry[]

  @@map("organizations")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  role            UserRole     @default(ADMIN)
  organizationId  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  emailVerifiedAt DateTime?
  isDisabled      Boolean      @default(false)
  lastLoginAt     DateTime?
  otps            Otp[]
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Moment          Moment[]
  feedbackEntries FeedbackEntry[]

  @@map("users")
}

model Otp {
  id          String     @id @default(cuid())
  email       String
  userId      String?
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@map("otps")
}

model OnboardingProgress {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  completedSteps        String[]
  testEmailSentAt       DateTime?
  automationActivatedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model Person {
  id              String            @id @default(cuid())
  fullName        String
  firstName       String?
  email           String
  birthday        DateTime
  department      String?
  role            String?
  optedOut        Boolean           @default(false)
  organizationId  String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  phone           String?
  deliveryLogs    DeliveryLog[]
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  MomentRecipient MomentRecipient[]

  @@unique([organizationId, email])
  @@map("people")
}

model Template {
  id            String                 @id @default(cuid())
  name          String
  type          TemplateType
  subject       String
  content       String
  imageUrl      String?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  isSystem      Boolean                @default(false)
  channels      DeliveryChannel[]      @default([email])
  deliveryLogs  DeliveryLog[]
  organizations OrganizationTemplate[]
  Moment        Moment[]

  @@map("templates")
}

model DeliveryLog {
  id             String          @id @default(cuid())
  personId       String
  templateId     String
  organizationId String
  status         DeliveryStatus  @default(QUEUED)
  scheduledFor   DateTime
  sentAt         DateTime?
  deliveredAt    DateTime?
  errorMessage   String?
  retryCount     Int             @default(0)
  externalId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  channel        DeliveryChannel @default(email)
  momentid       String?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person         Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  template       Template        @relation(fields: [templateId], references: [id])
  Moment         Moment?         @relation(fields: [momentId], references: [id])
  momentId       String?

  @@map("delivery_logs")
}

model OrganizationTemplate {
  id             String       @id @default(cuid())
  organizationId String
  templateId     String
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  assignedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([organizationId, templateId])
  @@map("organization_templates")
}

model SchedulerRun {
  id             String       @id @default(cuid())
  organizationId String
  runDate        String
  runTime        DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, runDate])
  @@map("scheduler_runs")
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String   @unique
  organization String
  role         String?
  teamSize     String?
  country      String?
  createdAt    DateTime @default(now())
  firstName    String
  lastName     String

  @@map("waitlist_entries")
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  role         AdminRole       @default(SUPER_ADMIN)
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AdminAuditLog[]
  invitesSent  AdminInvite[]   @relation("AdminInviteCreator")
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

model AdminAuditLog {
  id         String    @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_audit_logs")
}

model AdminInvite {
  id        String    @id @default(cuid())
  email     String
  role      AdminRole @default(SUPPORT)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  creator   AdminUser @relation("AdminInviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("admin_invites")
}

enum MomentCategory {
  BIRTHDAY
  ANNIVERSARY
  GRADUATION
  PROMOTION_CAREER_MILESTONE
  SPIRITUAL_MILESTONE
  REMEMBRANCE_DAY
  CUSTOM
}

enum MomentRecurrence {
  ONE_TIME
  ANNUAL
  DAILY
  MONTHLY
  QUARTERLY
  BI_YEARLY
  CUSTOM
}

enum MomentOwnerType {
  ORGANIZATION
  USER
}

enum MomentStatus {
  ACTIVE
  PAUSED
}

model Moment {
  id                  String            @id @default(cuid())
  title               String
  category            MomentCategory
  eventDate           DateTime
  recurrenceRule      MomentRecurrence  @default(ANNUAL)
  customIntervalDays  Int?
  randomizeMessage    Boolean           @default(false)
  deliveryChannels    DeliveryChannel[] @default([email])
  templateId          String?
  template            Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  ownerType           MomentOwnerType   @default(ORGANIZATION)
  ownerOrganizationId String?
  ownerOrganization   Organization?     @relation(fields: [ownerOrganizationId], references: [id], onDelete: Cascade)
  ownerUserId         String?
  ownerUser           User?             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  status              MomentStatus      @default(ACTIVE)
  recipients          MomentRecipient[]
  deliveryLogs        DeliveryLog[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([ownerOrganizationId, status])
  @@index([ownerUserId, status])
  @@index([eventDate, recurrenceRule, status])
  @@map("moments")
}

model MomentRecipient {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([momentId, personId])
  @@index([personId])
  @@map("moment_recipients")
}

enum ErrorSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

model SystemErrorLog {
  id             String           @id @default(cuid())
  source         String
  category       String
  severity       ErrorSeverity    @default(ERROR)
  message        String
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  channel        DeliveryChannel?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([source, createdAt])
  @@index([category, createdAt])
  @@index([organizationId, createdAt])
  @@map("system_error_logs")
}

model FeedbackEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type           FeedbackType
  subject        String?
  message        String       @db.Text
  pagePath       String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([type, createdAt])
  @@map("feedback_entries")
}

enum OrgPlan {
  FREE
  TRIAL
  PAID
}

enum UserRole {
  ADMIN
  VIEWER
}

enum OtpPurpose {
  REGISTER_VERIFY
  PASSWORD_RESET
}

enum TemplateType {
  PLAIN_TEXT
  HTML
  CUSTOM_IMAGE
}

enum DeliveryChannel {
  email
  sms
  whatsapp
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  OPTED_OUT
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  SUGGESTION
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
}
