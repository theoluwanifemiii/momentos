generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String                 @id @default(cuid())
  name                String
  timezone            String                 @default("UTC")
  emailFromName       String?
  emailFromAddress    String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  birthdayLastRunAt   DateTime?
  birthdaySendHour    Int                    @default(9)
  birthdaySendMinute  Int                    @default(0)
  isSuspended         Boolean                @default(false)
  plan                OrgPlan                @default(FREE)
  suspendedAt         DateTime?
  smsEnabled          Boolean                @default(false)
  senderId            String?                @default("MomentOS")
  whatsappEnabled     Boolean                @default(false)
  deliveryLogs        DeliveryLog[]
  onboarding          OnboardingProgress?
  templateAssignments OrganizationTemplate[]
  people              Person[]
  schedulerRuns       SchedulerRun[]
  users               User[]

  @@map("organizations")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  role            UserRole     @default(ADMIN)
  organizationId  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  emailVerifiedAt DateTime?
  isDisabled      Boolean      @default(false)
  lastLoginAt     DateTime?
  otps            Otp[]
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Otp {
  id          String     @id @default(cuid())
  email       String
  userId      String?
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@map("otps")
}

model OnboardingProgress {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  completedSteps        String[]
  testEmailSentAt       DateTime?
  automationActivatedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model Person {
  id             String        @id @default(cuid())
  fullName       String
  firstName      String?
  email          String
  birthday       DateTime
  department     String?
  role           String?
  optedOut       Boolean       @default(false)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  phone          String?
  deliveryLogs   DeliveryLog[]
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@map("people")
}

model Template {
  id            String                 @id @default(cuid())
  name          String
  type          TemplateType
  subject       String
  content       String
  imageUrl      String?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  isSystem      Boolean                @default(false)
  channels      DeliveryChannel[]      @default([email])
  deliveryLogs  DeliveryLog[]
  organizations OrganizationTemplate[]

  @@map("templates")
}

model DeliveryLog {
  id             String          @id @default(cuid())
  personId       String
  templateId     String
  organizationId String
  status         DeliveryStatus  @default(QUEUED)
  scheduledFor   DateTime
  sentAt         DateTime?
  deliveredAt    DateTime?
  errorMessage   String?
  retryCount     Int             @default(0)
  externalId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  channel        DeliveryChannel @default(email)
  momentid       String?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person         Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  template       Template        @relation(fields: [templateId], references: [id])

  @@map("delivery_logs")
}

model OrganizationTemplate {
  id             String       @id @default(cuid())
  organizationId String
  templateId     String
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  assignedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([organizationId, templateId])
  @@map("organization_templates")
}

model SchedulerRun {
  id             String       @id @default(cuid())
  organizationId String
  runDate        String
  runTime        DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, runDate])
  @@map("scheduler_runs")
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String   @unique
  organization String
  role         String?
  teamSize     String?
  country      String?
  createdAt    DateTime @default(now())
  firstName    String
  lastName     String

  @@map("waitlist_entries")
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  role         AdminRole       @default(SUPER_ADMIN)
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AdminAuditLog[]
  invitesSent  AdminInvite[]   @relation("AdminInviteCreator")
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

model AdminAuditLog {
  id         String    @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_audit_logs")
}

model AdminInvite {
  id        String    @id @default(cuid())
  email     String
  role      AdminRole @default(SUPPORT)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  creator   AdminUser @relation("AdminInviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("admin_invites")
}

enum OrgPlan {
  FREE
  TRIAL
  PAID
}

enum UserRole {
  ADMIN
  VIEWER
}

enum OtpPurpose {
  REGISTER_VERIFY
  PASSWORD_RESET
}

enum TemplateType {
  PLAIN_TEXT
  HTML
  CUSTOM_IMAGE
}

enum DeliveryChannel {
  email
  sms
  whatsapp
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  OPTED_OUT
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
}
