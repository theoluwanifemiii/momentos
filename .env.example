# Copy this file to .env and fill in your values before running docker-compose.

# PostgreSQL
POSTGRES_DB=momentos
POSTGRES_USER=momentos
POSTGRES_PASSWORD=change_me_strong_password

# Backend
DATABASE_URL=postgresql://momentos:change_me_strong_password@postgres:5432/momentos
JWT_SECRET=replace_with_a_long_random_secret

# PostHog (optional - analytics no-op if unset)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Postman sync (optional)
POSTMAN_API_KEY=
